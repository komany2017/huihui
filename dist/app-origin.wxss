.h5-button,.h5-form,.h5-input,.h5-label,.h5-textarea,image,navigator,page,scroll-view,swiper,swiper-item,text,view{-webkit-box-sizing:border-box;box-sizing:border-box}page{background-color:#f8f5f0;color:#2b2520;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,PingFang SC,Hiragino Sans GB,sans-serif;font-size:28rpx;line-height:1.5}.page-container{background:-webkit-gradient(linear,left top,left bottom,from(#fdf8f0),to(#f8f5f0));background:-webkit-linear-gradient(top,#fdf8f0,#f8f5f0);background:linear-gradient(180deg,#fdf8f0,#f8f5f0);min-height:100vh}.card-base{background:#fff;border-radius:16rpx;-webkit-box-shadow:0 2rpx 12rpx rgba(43,37,32,.06);box-shadow:0 2rpx 12rpx rgba(43,37,32,.06)}.btn-primary{-webkit-align-items:center;background:-webkit-linear-gradient(315deg,#c8362f,#e85d56);background:linear-gradient(135deg,#c8362f,#e85d56);border-radius:48rpx;color:#fff;display:-webkit-flex;display:-ms-flexbox;display:flex;font-size:32rpx;font-weight:500;height:96rpx;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;-webkit-transition:all .25s ease;transition:all .25s ease}.btn-primary:active{opacity:.9;-webkit-transform:scale(.98);-ms-transform:scale(.98);transform:scale(.98)}.safe-bottom{padding-bottom:calc(env(safe-area-inset-bottom) + 120rpx)}